{
  "input": [
    {
      "type": "private",
      "action": "add"
    },
    {
      "type": "text",
      "action": "add",
      "args": {
        "name": "ru",
        "uri": "https://cdn.jsdelivr.net/gh/Loyalsoldier/geoip@release/text/ru.txt"
      }
    },
    {
      "type": "clashRuleSet",
      "action": "add",
      "args": {
        "name": "antifilter",
        "uri": "https://raw.githubusercontent.com/proxykeys/filter/main/release/clash-antifilter-ip.yaml"
      }
    }
  ],
  "output": [
    {
      "type": "maxmindMMDB",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "outputName": "Country.mmdb",
        "wantedList": ["private", "ru", "antifilter"]
      }
    }
  ]
}
